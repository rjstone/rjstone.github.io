{
  "name": "rjstone-gh-pages",
  "type": "module",
  "version": "2.3.2",
  "description": "Personal site for rjstone, based on the Nordlys template",
  "author": "rjstone",
  "license": "GPL-3.0-only",
  "homepage": "https://rjstone.net",
  "repository": {
    "type": "git",
    "url": "https://github.com/rjstone/rjstone.github.io"
  },
  "bugs": {
    "url": "https://github.com/rjstone/rjstone.github.io/issues"
  },
  "keywords": [
    "astro",
    "blog",
    "tailwindcss",
    "nordlys"
  ],
