    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@iconify-json/tabler": "^1.2.43",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.4",
    "mdast-util-to-string": "^4.0.0",
    "pagefind": "^1.5.2",
    "reading-time": "^1.5.0",
    "satori": "^0.33.5",
    "sharp": "^0.35.5",
    "tailwind-scrollbar-hide": "^4.0.0",
    "tailwindcss": "^4.3.3"
